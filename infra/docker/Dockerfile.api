# Security Passport API — multi-stage, non-root, frozen deps.
FROM python:3.12-slim AS build
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN python -m pip install --no-cache-dir --upgrade pip \
 && python -m pip wheel --no-cache-dir --no-deps -w /wheels .

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    SECURITY_PASSPORT_DATA=/data
RUN useradd -r -u 10001 -m passport
WORKDIR /app
# locked runtime deps first — rebuilds never re-resolve versions
COPY pyproject.toml uv.lock ./
RUN python -m pip install --no-cache-dir uv==0.11.25 \
 && uv export --frozen --no-dev --no-hashes --no-emit-project \
   -o /tmp/reqs.txt \
 && python -m pip install --no-cache-dir -r /tmp/reqs.txt
COPY --from=build /wheels /wheels
RUN python -m pip install --no-cache-dir --no-deps /wheels/*.whl \
 && rm -rf /wheels /tmp/reqs.txt \
 && python -m pip uninstall -y uv 2>/dev/null || true
USER passport
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health/live',timeout=4).status==200 else 1)"
CMD ["python", "-m", "uvicorn", "security_passport.api.app:app", \
     "--host", "0.0.0.0", "--port", "8000"]
