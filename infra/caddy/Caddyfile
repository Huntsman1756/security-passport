# Security Passport — edge: TLS, /api proxy, SPA fallback.
# PUBLIC_BASE_URL is set via environment (e.g. passport.example.org).

{$PUBLIC_BASE_URL:passport.localhost} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# only meaningful over TLS; browsers ignore it on plain-HTTP dev
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	@api path /api/* /health/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	# hashed build assets never change; the SPA shell must revalidate
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@shell not path /assets/* /api/* /health/*
	header @shell Cache-Control "no-cache"

	root * /srv

	# The SPA owns exactly these addresses (see web/src/main.tsx). Everything else
	# is not a page: before, `try_files {path} /index.html` answered the shell with
	# 200 for any unknown path, so /no-existe-qa and /assets/missing.js looked like
	# real pages (soft 404). Now only real files and known routes answer 200.
	@spa path / /corpus /sources /isin/*
	handle @spa {
		try_files {path} /index.html
		file_server
	}

	handle {
		try_files {path} =404
		file_server
	}

	log {
		output stdout
		format json
	}
}
