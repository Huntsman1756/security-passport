# Security Passport configuration
# Copy to .env for local development; containers use real env vars.

# Provider mode: fixtures | openinstrument_api
SECURITY_PASSPORT_PROVIDER=fixtures

# OpenInstrument upstream (required for openinstrument_api mode)
OPENINSTRUMENT_URL=http://127.0.0.1:8000

# Local data root: generations + own-source stores live here
SECURITY_PASSPORT_DATA=data

# Fixture corpus (fixture mode only)
SECURITY_PASSPORT_FIXTURES=tests/fixtures/corpus

# Public base URL for deployment metadata (no trailing slash)
PUBLIC_BASE_URL=http://localhost:5173

# API settings
SECURITY_PASSPORT_API_HOST=127.0.0.1
SECURITY_PASSPORT_API_PORT=8000
# Comma-separated CORS origins for the web frontend
SECURITY_PASSPORT_CORS_ORIGINS=http://localhost:5173
